# ==============================================================================
# NAT RAS Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# NEVER COMMIT .env TO VERSION CONTROL
# ==============================================================================

# Core System Safety
# CRITICAL: LIVE_ORDERS_ENABLED must strictly remain false.
# Any setting other than 'false' will cause the safety system to fail-closed and abort.
LIVE_ORDERS_ENABLED=false
SYSTEM_ENV=development
LOG_LEVEL=INFO

# Market & Trading Time Constraints
MARKET_TIMEZONE=Asia/Kolkata
ENTRY_CUTOFF_TIME=15:00
CANDLE_TIMEFRAME_MINUTES=5

# Strategy Family (Locked to current scope)
STRATEGY_FAMILY=v2.2.0-RESEARCH-MOMENTUM-WICK

# Database Persistence
DATABASE_PATH=data/natras.db

# Risk Governor Defaults
MAX_DAILY_LOSS=5000.0
MAX_POSITION_SIZE=100
MAX_OPEN_POSITIONS=2
MAX_DAILY_TRADES=10

# Broker Integrations (NOT_IMPLEMENTED in Stage 0 - Placeholders only)
FYERS_APP_ID=your_fyers_app_id_here
FYERS_SECRET_KEY=your_fyers_secret_key_here
FYERS_REDIRECT_URI=https://127.0.0.1:5000/callback
FYERS_ACCESS_TOKEN=

UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=https://127.0.0.1:5000/callback
UPSTOX_ACCESS_TOKEN=

# Notifications (NOT_IMPLEMENTED in Stage 0 - Placeholders only)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
